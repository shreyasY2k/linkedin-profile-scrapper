# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored and must never be committed. Every value below is a
# placeholder — the stack will boot with them locally, and none of them is a
# real credential.
#
# There is deliberately no APP_ENV / ENVIRONMENT variable. Nothing in the code
# branches on an environment name; the same image runs locally and deployed,
# with only this file differing.

# --- Postgres (compose + application) ---------------------------------------
POSTGRES_USER=linkedin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=linkedin

# Read by app/config.py.
#
# Inside `docker compose`, this line is IGNORED: the api service composes
# DATABASE_URL from the three POSTGRES_* values above and injects it, and a
# compose-level `environment` entry overrides anything in this file. Those
# three variables are the single source of truth for the credentials — edit
# them, not this line.
#
# The line is kept because it is part of the env contract app/config.py
# declares, and because it is what a run OUTSIDE compose (a bare `uvicorn`, a
# one-off script) would read. Only such a run needs it to be accurate.
DATABASE_URL=postgresql://linkedin:change-me-local-only@postgres:5432/linkedin

# --- Keycloak bootstrap admin (compose only) --------------------------------
# KC_BOOTSTRAP_ADMIN_* is the supported pair since Keycloak 26.0.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only

# --- Keycloak, as the API sees it (read by app/config.py) -------------------
#
# TWO URLs, and they are not interchangeable. Same Keycloak, two sides of it:
#
#   KEYCLOAK_SERVER_URL  where the API container FETCHES the realm's signing
#                        keys. A compose service name, resolvable only inside
#                        the stack. Never appears in a token.
#   KEYCLOAK_ISSUER_URL  the base URL a caller MINTS through, and therefore the
#                        base of the `iss` claim their token carries. The API
#                        requires `iss` to equal exactly
#                        ${KEYCLOAK_ISSUER_URL}/realms/${KEYCLOAK_REALM}.
#
# Locally the mint URL is http://127.0.0.1:8080. Deployed, tokens are minted
# through nginx, so this becomes the public https:// name — and a token minted
# at one of those and presented to an API configured for the other is rejected
# with 401 UNAUTHENTICATED, correctly. Mint at exactly this URL.
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=linkedin
KEYCLOAK_CLIENT_ID=linkedin-profile-api

# Also read by the KEYCLOAK container: the committed realm export at
# deploy/keycloak/realm-linkedin.json carries ${KEYCLOAK_CLIENT_SECRET} as a
# placeholder, and Keycloak substitutes this value at import. That is what
# keeps the export secret-free.
#
# The import runs with strategy IGNORE_EXISTING, so it only takes effect on a
# realm that does not exist yet. Changing this line after the first boot needs
# either `docker compose down -v` or a rotation in the admin console.
KEYCLOAK_CLIENT_SECRET=change-me-client-secret

# --- A SECOND caller, so CAP-4 is demonstrable ------------------------------
#
# Read ONLY by the Keycloak container, to substitute into the realm export. The
# API never reads these — app/config.py has no field for them, deliberately.
#
# Why a second client exists: every caller minting through the client above
# shares ONE service-account user, and therefore one `sub`. Per-caller session
# isolation is real in the code and impossible to show in a running stack with
# only one subject — and two people sharing those credentials would silently
# overwrite each other's stored LinkedIn cookie. This client is a second
# subject, and nothing else. The client above stays THE evaluator lane.
#
# Its token still carries `aud: ${KEYCLOAK_CLIENT_ID}`, because that is the
# audience the API validates against. Two callers, one API.
KEYCLOAK_SECOND_CLIENT_ID=linkedin-profile-api-second-caller
KEYCLOAK_SECOND_CLIENT_SECRET=change-me-second-client-secret

# --- Application secrets (read by app/config.py) ----------------------------
#
# Encrypts stored LinkedIn session cookies at rest (story 5's vault). This must
# be a real Fernet key — 32 bytes, url-safe base64 — not an arbitrary
# passphrase: the API validates it at boot and refuses to start on anything
# else, because a service that cannot encrypt must not accept a cookie.
#
# GENERATE YOUR OWN BEFORE DEPLOYING ANYTHING:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# The placeholder below is a valid key so that a clean clone boots, and it is
# deliberately worthless: base64-decode it and it reads
# "change-me-generate-a-real-key!!!". Anyone with this repository has it, so a
# deployment left on it is a deployment whose stored cookies are readable by
# anyone who can read the table.
SESSION_ENCRYPTION_KEY=Y2hhbmdlLW1lLWdlbmVyYXRlLWEtcmVhbC1rZXkhISE=

# --- Developer-only, OPTIONAL: leave this blank ------------------------------
#
# Your own LinkedIn `li_at` cookie. The only variable app/config.py treats as
# optional, and blank is a valid, complete value — leave it blank.
#
# Nothing in the running service reads it: callers supply their own session
# through `PUT /api/v1/session`, and docker-compose.yml blanks it for the api
# container so a filled-in value never reaches the running process. It is read
# only by the opt-in live check, which fetches YOUR OWN profile and spends real
# quota against a real account:
#
#   LINKEDIN_LIVE_CHECK=1 pytest -q -m live
#
# To fill it in: log in to LinkedIn, DevTools -> Application -> Cookies ->
# https://www.linkedin.com -> li_at. Paste it into your local .env, never here
# — .env is gitignored, this example file is committed.
LINKEDIN_DEV_COOKIE=
